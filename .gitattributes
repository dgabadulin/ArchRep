# Demo / shell: только LF, иначе на Linux ломается `source env.demo` и пароли в docker compose.
infra/demo/env.demo text eol=lf
infra/demo/env.demo.example text eol=lf
infra/demo/*.sh text eol=lf

# Скрипты и хуки: LF в репозитории, CRLF в рабочей копии Windows не нужен,
# но .bat/.cmd должны быть CRLF при checkout (cmd.exe), а shell-скрипты — строго LF.
*.sh    text eol=lf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Git-хуки: у файлов нет расширения, но они исполняются sh — только LF.
.githooks/* text eol=lf

