# Сборка фронта (Vue v3, Vite), затем backend + статика в одном образе
# Контекст сборки: корень репозитория (docker build -f infra/common/dockerfile .)
# Статика: корень сайта /

FROM node:20-alpine AS frontend-v3-build
WORKDIR /app/frontend-v3

# Версия продукта (issue #96): передаётся из deploy.bat (git describe) и попадает
# в бандл через vite define. Без build-arg будет "0.0.0".
ARG APP_VERSION=0.0.0
ARG APP_COMMIT=
ARG APP_BUILD_TIME=
ENV APP_VERSION=$APP_VERSION APP_COMMIT=$APP_COMMIT APP_BUILD_TIME=$APP_BUILD_TIME

# Зависимости отдельным слоем: кэш не сбрасывается при правке исходников фронта.
COPY frontend-v3/package.json frontend-v3/package-lock.json* ./
RUN npm ci --no-audit --no-fund 2>/dev/null || npm install --no-audit --no-fund

# Копируем ТОЛЬКО исходники фронта. `COPY frontend-v3 .` опасен: он приносит
# локальный (Windows) node_modules поверх установленного здесь — и тогда
# node_modules/.bin/vite без exec-бита, сборка падает:
# «sh: vite: Permission denied», exit 126.
# При добавлении новых корневых файлов/папок фронта — дополнить список COPY.
COPY frontend-v3/index.html frontend-v3/vite.config.js ./
COPY frontend-v3/public ./public
COPY frontend-v3/src ./src

# Фронт подключаемого модуля (build-time, docs/modules-contract.md §7.2):
# vite.config.js ищет его в ../modules/drawio-pro (см. resolveDrawioProDir). Без этой строки
# в контейнере собирается заглушка, и кнопка модуля не появляется.
COPY modules /app/modules

RUN npm run build

FROM node:20-alpine
WORKDIR /app

# Версия продукта в рантайме (GET /api/version, /api/health) — из build-arg деплоя.
ARG APP_VERSION=0.0.0
ARG APP_COMMIT=
ARG APP_BUILD_TIME=
ARG APP_CHANNEL=stable
ENV APP_VERSION=$APP_VERSION APP_COMMIT=$APP_COMMIT APP_BUILD_TIME=$APP_BUILD_TIME APP_CHANNEL=$APP_CHANNEL

COPY package.json package-lock.json* ./
RUN npm install --omit=dev

# Миграции и конфиг node-pg-migrate (npm run db:migrate в demo/prod deploy)
COPY pgmrc.json ./
COPY DB/migrations ./DB/migrations
# SQL, на который ссылаются миграции через readFileSync (см. DB/migrations/*.js)
COPY DB/scripts ./DB/scripts

COPY backend ./backend
# Backend-часть модулей: загрузчик ищет пакет в <repo>/modules/<code> (или в node_modules,
# если ставите @isar/* как зависимость сборки). Без этой строки в контейнере модуля нет.
COPY modules ./modules
COPY --from=frontend-v3-build /app/frontend-v3-dist ./frontend-v3-dist

EXPOSE 5000
CMD ["node", "backend/index.js"]
