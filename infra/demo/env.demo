# Demo-окружение (коммитится осознанно — только для изолированного демо-сервера).
# Секреты не для prod.

POSTGRES_USER=isar
POSTGRES_PASSWORD=archrep01
# БД для initdb / pg_isready; дамп сам создаёт рабочую БД archrep (CREATE DATABASE).
POSTGRES_DB=postgres

# Подключение приложения к БД после импорта дампа
DB_NAME=archrep

# NODE_ENV для Node: development | production (не значение "demo" — иначе ищется .env.demo)
# В контейнере переменные БД задаёт compose; dotenv подхватит .env.production только если положить файл в образ.

CORS_ORIGIN=http://archrep.ru:3000
DRAWIO_EMBED_BASE=https://archrep.ru/drawio

# ADMIN_API_RESTART_SECRET=123qwe!
# ALLOW_INSECURE_RESTART_WITHOUT_SECRET=true
