# Demo-окружение (коммитится осознанно — только для изолированного демо-сервера).
# Секреты не для prod.

POSTGRES_USER=isar
POSTGRES_PASSWORD=CHANGE_ME
# БД для initdb / pg_isready; дамп сам создаёт рабочую БД archrep (CREATE DATABASE).
POSTGRES_DB=postgres

# Подключение приложения к БД после импорта дампа
DB_NAME=archrep

# NODE_ENV для Node: development | production (не значение "demo" — иначе ищется .env.demo)
# В контейнере переменные БД задаёт compose; dotenv подхватит .env.production только если положить файл в образ.

CORS_ORIGIN=http://localhost:3000
DRAWIO_EMBED_BASE=https://drawio.example.com

# ADMIN_API_RESTART_SECRET=
# ALLOW_INSECURE_RESTART_WITHOUT_SECRET=true

# --- Авторизация (см. docs/access-control-design.md §3.1) ---
# false / не задано — open mode: без формы логина, JWT не требуется
# true  — локальный login + JWT + RBAC
# AUTH_ENABLED=false
#
# Секрет подписи JWT (обязателен при AUTH_ENABLED=true). Не коммитить реальные значения.
# Можно сгенерировать в powershell командой: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=CHANGE_ME

# Bootstrap обязательных пользователей (login demo / aradmin, роль SYSTEM_ADMIN).
# Создаются кодом backend/auth/bootstrapAuth.js при старте API (отдельного SQL-скрипта нет).
# В БД пишется только password_hash; plaintext — только здесь на стенде / в secret manager.
AUTH_BOOTSTRAP_DEMO_PASSWORD=CHANGE_ME
AUTH_BOOTSTRAP_ARADMIN_PASSWORD=CHANGE_ME
# true — перезаписать hash существующих demo/aradmin из env при bootstrap (осторожно на prod)
AUTH_BOOTSTRAP_RESET_PASSWORDS=false
# must_change_password у создаваемых bootstrap-пользователей
AUTH_BOOTSTRAP_MUST_CHANGE_PASSWORD=false

# --- Keycloak / OIDC (фаза B) — заполнить на стенде; secret не коммитить ---
# KEYCLOAK_ENABLED=false
# KEYCLOAK_LOGIN_MODE=button
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# KEYCLOAK_APP_PUBLIC_URL=http://localhost:3000

# --- ИИ-архитектор (issue #78; docs/ai-architect.md §5) ---
# Публичные параметры панели живут в ar_settings_parameters (группа «ИИ-архитектор»): SYS_AI_ENABLED,
# SYS_AI_TITLE, SYS_AI_PANEL_WIDTH, SYS_AI_HISTORY_LIMIT — при необходимости переопределяются env.
SYS_AI_ENABLED=true
# Имя модели: в коде дефолта нет — для demo-стенда задаётся здесь (env имеет приоритет над параметром БД).
SYS_AI_MODEL=deepseek-reasoner
# Секреты и адрес LLM — только здесь (в /api/config не публикуются).
# Реальный ключ НЕ коммитим: подставьте его на стенде (локально он в .env.production).
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=CHANGE_ME
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_MAX_ITERATIONS=5
