# Скопируйте в env.demo и подставьте значения (или правьте env.demo напрямую в репо для демо-only).

POSTGRES_USER=isar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
DB_NAME=archrep

CORS_ORIGIN=http://DEMO_HOST:3000
DRAWIO_EMBED_BASE=http://DEMO_HOST:8080

ALLOW_INSECURE_RESTART_WITHOUT_SECRET=true

# Опционально: полный URL iframe «Тех.радар» (переопределяет дефолт и БД в GET /api/config)
# TECH_RADAR_EMBED_URL=https://example.com/radar/?documentId=...

# --- Авторизация (docs/access-control-design.md §3.1) ---
# Bootstrap demo/aradmin: backend/auth/bootstrapAuth.js при старте API (не SQL).
# AUTH_ENABLED=false
# JWT_SECRET=
# AUTH_BOOTSTRAP_DEMO_PASSWORD=
# AUTH_BOOTSTRAP_ARADMIN_PASSWORD=
# AUTH_BOOTSTRAP_RESET_PASSWORDS=false
# AUTH_BOOTSTRAP_MUST_CHANGE_PASSWORD=false
