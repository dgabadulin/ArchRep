# Скопируйте в env.demo и подставьте значения (или правьте env.demo напрямую в репо для демо-only).

POSTGRES_USER=isar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
DB_NAME=archrep

CORS_ORIGIN=http://DEMO_HOST:3000
DRAWIO_EMBED_BASE=http://DEMO_HOST:8080

ALLOW_INSECURE_RESTART_WITHOUT_SECRET=true

# Опционально: полный URL iframe «Тех.радар» (переопределяет дефолт и БД в GET /api/config)
# TECH_RADAR_EMBED_URL=https://example.com/radar/?documentId=...

# --- Авторизация (docs/access-control-design.md §3.1) ---
# Bootstrap demo/aradmin: backend/auth/bootstrapAuth.js при старте API (не SQL).
# AUTH_ENABLED=false
# JWT_SECRET=
# AUTH_BOOTSTRAP_DEMO_PASSWORD=
# AUTH_BOOTSTRAP_ARADMIN_PASSWORD=
# AUTH_BOOTSTRAP_RESET_PASSWORDS=false
# AUTH_BOOTSTRAP_MUST_CHANGE_PASSWORD=false

# --- Keycloak / OIDC (фаза B) — секреты только на стенде, не в git ---
# KEYCLOAK_ENABLED=false
# KEYCLOAK_LOGIN_MODE=button
# KEYCLOAK_ISSUER=
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_REDIRECT_URI=http://DEMO_HOST:3000/api/auth/oidc/callback
# KEYCLOAK_APP_PUBLIC_URL=http://DEMO_HOST:3000

# --- ИИ-архитектор (issue #78; docs/ai-architect.md §5) ---
# Публичные параметры панели живут в ar_settings_parameters (группа «ИИ-архитектор»):
# SYS_AI_ENABLED, SYS_AI_TITLE, SYS_AI_PANEL_WIDTH, SYS_AI_HISTORY_LIMIT — env переопределяет параметр БД.
SYS_AI_ENABLED=true
# Имя модели: в коде дефолта нет — задаётся на стенде (env имеет приоритет над параметром БД).
SYS_AI_MODEL=
# Секреты и адрес LLM — только на стенде, в git не коммитим (в /api/config не публикуются):
AI_BASE_URL=
# AI_API_KEY=
# AI_TIMEOUT_MS=120000
# AI_MAX_TOKENS=1024
# AI_TEMPERATURE=0.2
# AI_MAX_ITERATIONS=5
