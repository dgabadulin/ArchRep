.dockerenv
docker-compose.override.yml
volumes/

# Логи
logs/
*.log

# IDE
.idea/
.vscode/

# utils
hotlist.cmd

# Локальный деплой с учётными данными (не для репозитория)
deploy_local.bat
deploy_demo.bat
deploy_demo_full.bat
deploy_demo_api.bat

# Реальные значения demo-стенда (пароль БД, ключ LLM, адреса хоста).
# Доставляется на сервер по scp из infra/demo/deploy.bat, в архив деплоя и в git не попадает.
# Уже покрыт правилом `.env.*` выше — строка оставлена как явный маркер.
.env.demo.secret

# Временные файлы / экспорты графа
temp/

# Архив исходников, который создаёт deploy.bat (пакуется на месте, передаётся по scp)
deploy_stage.tar.gz
# Временный скрипт удалённой сборки: создаётся deploy.bat и удаляется после ssh.
# При прерванном деплое остаётся в дереве и раньше «загрязнял» precheck.
remote_script.sh
# Рантайм-файл преддеплойной проверки (создаёт и удаляет infra/prod/deploy.bat)
deploy_version.env

# Артефакт сборки frontend-v3 (vite build → ../frontend-v3-dist)
frontend-v3-dist/

# Draw.io — локальный бэкап редактора (не коммитить)
.$*.drawio.bkp

# Подключаемые модули удалены в v4.0.0 (единое ядро): каталог modules/ больше не используется.
