# =============================================================================
# Шаблон переменных окружения для backend (корень репозитория).
# Скопируйте этот файл в один из файлов (НЕ коммитьте копии с паролями):
#   .env.development   — локальная разработка (NODE_ENV=development)
#   .env.production    — прод/стенд (NODE_ENV=production)
#
# Приложение читает `.env.${NODE_ENV}` из корня при запуске (см. backend/index.js).
# =============================================================================

# --- Общее ---
NODE_ENV=development
SERVER_PORT=3000

# --- База данных PostgreSQL ---
# DB_HOST: имя сервиса в Docker-сети (например postgres) или localhost при запуске Node на хосте
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Задайте надёжный пароль; в репозиторий не вносить
DB_PASSWORD=
DB_NAME=postgres

# --- CORS (опционально) ---
# Один origin или несколько через запятую. Для dev: Vite часто на 5175
# CORS_ORIGIN=http://localhost:5175
# Если фронт и API с одного хоста/порта — можно не задавать

# --- Публичный конфиг для фронта (GET /api/config; переопределяет значения из ar_settings_parameters) ---
# Базовый URL Draw.io для встраивания диаграмм
# DRAWIO_EMBED_BASE=http://localhost:8080
# Полный URL iframe «Тех.радар» (внешний сервис, query documentId и т.д.)
# TECH_RADAR_EMBED_URL=https://example.com/radar/?documentId=...

# --- Авторизация (см. docs/access-control-design.md §3.1) ---
# false / не задано — open mode: без формы логина, JWT не требуется
# true  — локальный login + JWT + RBAC
# AUTH_ENABLED=false
#
# Секрет подписи JWT (обязателен при AUTH_ENABLED=true). Не коммитить реальные значения.
# Можно сгенерировать в powershell командой: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# JWT_SECRET=

# Bootstrap обязательных пользователей (login demo / aradmin, роль SYSTEM_ADMIN).
# Создаются кодом backend/auth/bootstrapAuth.js при старте API (отдельного SQL-скрипта нет).
# В БД пишется только password_hash; plaintext — только здесь на стенде / в secret manager.
# AUTH_BOOTSTRAP_DEMO_PASSWORD=
# AUTH_BOOTSTRAP_ARADMIN_PASSWORD=
# true — перезаписать hash существующих demo/aradmin из env при bootstrap (осторожно на prod)
# AUTH_BOOTSTRAP_RESET_PASSWORDS=false
# must_change_password у создаваемых bootstrap-пользователей
# AUTH_BOOTSTRAP_MUST_CHANGE_PASSWORD=false

# --- Keycloak / OIDC (фаза B; docs/access-control-design.md §3.1) ---
# Вкл. SSO также через параметр БД SEC_KEYCLOAK_ENABLED (UI «Параметры»).
# Приоритет: env KEYCLOAK_* > SEC_* в БД > default.
# KEYCLOAK_ENABLED=false
# KEYCLOAK_LOGIN_MODE=button
# KEYCLOAK_ISSUER=https://sso.example/realms/common
# KEYCLOAK_CLIENT_ID=
# KEYCLOAK_CLIENT_SECRET=
# Valid Redirect URI в KC должен совпасть с этим callback API:
# KEYCLOAK_REDIRECT_URI=https://example.com/api/auth/oidc/callback
# Куда вернуть браузер после успеха (origin фронта). Если пусто — из Origin/Referer/X-Forwarded-*.
# KEYCLOAK_APP_PUBLIC_URL=https://example.com
# KEYCLOAK_ACCOUNT_URL=https://sso.example/realms/common/account

# --- SMTP (Job Runner: уведомления; секреты только в env) ---
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=isar-noreply@example.com

# --- Прод: перезапуск API из UI (Настройки → Сервисные операции) ---
# Задайте секрет и введите его в модалке; либо только для доверенной среды:
# ADMIN_API_RESTART_SECRET=
# ALLOW_INSECURE_RESTART_WITHOUT_SECRET=false

# --- ИИ-архитектор (issue #78; docs/ai-architect.md §5) ---
# Публичные параметры панели живут в ar_settings_parameters (группа «ИИ-архитектор»): SYS_AI_ENABLED,
# SYS_AI_TITLE, SYS_AI_PANEL_WIDTH, SYS_AI_HISTORY_LIMIT — при необходимости переопределяются env.
# SYS_AI_ENABLED=true
# Имя модели: в коде дефолта нет. Задаётся либо здесь (env имеет приоритет над параметром БД),
# либо в UI: Настройки → Параметры → группа «ИИ-архитектор» (SYS_AI_MODEL).
# SYS_AI_MODEL=Qwen/Qwen3.5-397B-A17B-FP8
# Секреты и адрес LLM — только здесь (в /api/config не публикуются):
# AI_BASE_URL=https://ai.example.com/api/v1
# AI_API_KEY=
# AI_TIMEOUT_MS=120000
# AI_MAX_TOKENS=2048
# AI_TEMPERATURE=0.2
# AI_MAX_ITERATIONS=6

# --- Параметры приложения (справочники / метамодель; при необходимости) ---
# SYS_TECH_STACK_RELATION_CODE=system_technology
# MODULE_TECH_STACK_RELATION_CODE=module_technology
# GRAPH_COLLAPSED_SYSTEM_ICON=MonitorDot

# =============================================================================
# Пример блока для production (.env.production) — скопируйте нужные строки:
# NODE_ENV=production
# DB_HOST=postgres
# DB_PASSWORD=  # задать на сервере / в secret manager
# ALLOW_INSECURE_RESTART_WITHOUT_SECRET=true   # только если осознанно для тестового стенда
# =============================================================================
